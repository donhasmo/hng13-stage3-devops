# =====================================
# APP CONFIGURATION
# =====================================

BLUE_IMAGE=yimikaade/wonderful:devops-stage-two
GREEN_IMAGE=yimikaade/wonderful:devops-stage-two

# "blue" or "green" - controls which pool is primary in the nginx template
ACTIVE_POOL=blue

# release ids injected to apps so X-Release-Id is correct
RELEASE_ID_BLUE=v1.0.0
RELEASE_ID_GREEN=v2.0.0

# Application internal port (container exposes app on 3000 by default)
PORT=3000

# =====================================
# ALERT WATCHER CONFIGURATION
# =====================================

# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Minimum seconds between alerts
ALERT_COOLDOWN=60

# Enable or disable alerts (use "true" or "false")
MAINTENANCE_MODE=false

# Error rate threshold in percent
ERROR_THRESHOLD=2

# =====================================
# APP CONFIGURATION
# =====================================

BLBLUE_IMAGE=yimikaade/wonderful:devops-stage-two
GREEN_IMAGE=yimikaade/wonderful:devops-stage-two

# "blue" or "green" - controls which pool is primary
ACTIVE_POOL=blue

# release ids injected to apps so X-Release-Id is correct
RELEASE_ID_BLUE=v1.0.0
RELEASE_ID_GREEN=v2.0.0

# Application internal port (container exposes app on 3000 by default)
PORT=3000

# =====================================
# ALERT WATCHER CONFIGURATION
# =====================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/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
ALERT_COOLDOWN=60
MAINTENANCE_MODE=false
ERROR_THRESHOLD=2

WINDOW_SIZE=50
FLIP_COOLDOWN_SECONDS=30


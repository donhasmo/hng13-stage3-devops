# this file is generated from the template at container start
worker_processes  1;
events { worker_connections 1024; }

http {
    include       mime.types;
    default_type  application/octet-stream;

    # ==============================================
    # Custom JSON log format for structured logging
    # ==============================================
    log_format json_combined escape=json '{'
    '"time": "$time_iso8601", '
    '"remote_addr": "$remote_addr", '
    '"method": "$request_method", '
    '"uri": "$request_uri", '
    '"status": "$status", '
    '"request_time": "$request_time", '
    '"upstream_addr": "$upstream_addr", '
    '"upstream_status": "$upstream_status", '
    '"upstream_response_time": "$upstream_response_time", '
    '"x_app_pool": "$upstream_http_x_app_pool", '
    '"x_release_id": "$upstream_http_x_release_id", '
    '"bytes_sent": "$bytes_sent", '
    '"user_agent": "$http_user_agent"'
'}';


    # Write access logs using the above format
    access_log /var/log/nginx/access.json.log json_combined;

    # Upstream backend — primary and backup
    upstream backend {
        # primary server (templated)
        server ${PRIMARY_NAME}:$PORT max_fails=1 fail_timeout=5s;
        # backup server
        server ${BACKUP_NAME}:$PORT backup;
    }

    server {
        listen 80;
        server_name _;

        # Tight timeouts to detect failures quickly
        proxy_connect_timeout 1s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;

        # Retry policy
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 6s;

        location / {
            proxy_pass http://backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # Preserve all upstream response headers — do NOT hide app headers
        }
    }
}
